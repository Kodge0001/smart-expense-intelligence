# ─────────────────────────────────────────────
# Smart Expense Intelligence System — .env
# ─────────────────────────────────────────────
# Copy this file to `.env` and fill in values.
# The app works WITHOUT any API key (uses a
# rule-based fallback for categorization).
# ─────────────────────────────────────────────

# Pick ONE LLM provider and set its key:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional: override the model name
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# GOOGLE_MODEL=gemini-2.0-flash

# Auth & JWT Configuration
JWT_SECRET=supersecretjwtkey_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DAYS=7

# Email Provider Configuration (Resend, SendGrid, or SMTP)
# Leave blank to log OTP to server logs during local development
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Backend URL (used by the Streamlit frontend)
BACKEND_URL=http://localhost:8000

